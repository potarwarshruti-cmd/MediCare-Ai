# Environment Configuration for MediCare AI

# Backend Settings (Python FastAPI)
PORT=8000
DATABASE_URL=sqlite:///./medicare_ai.db
SECRET_KEY=medicare-ai-hackathon-secret-key-2026

# Weather API (Optional - Default uses built-in live weather simulator)
WEATHER_API_KEY=your_weather_api_key_here

# Frontend Settings (Vite React)
VITE_API_BASE_URL=http://localhost:8000/api

# Google Maps JavaScript API (Optional - Default falls back to interactive Leaflet OpenStreetMap)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
